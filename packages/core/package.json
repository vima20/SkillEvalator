{
  "name": "@skillevalator/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./costEstimate": {
      "types": "./dist/costEstimate.d.ts",
      "import": "./dist/costEstimate.js"
    },
    "./job": {
      "types": "./dist/job.d.ts",
      "import": "./dist/job.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./webAuthConfig": {
      "types": "./dist/webAuthConfig.d.ts",
      "import": "./dist/webAuthConfig.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "vitest": "^3.0.9"
  }
}
